{
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "suggestions"],
  "properties": {
    "reply": {"type": "string"},
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ingredients"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reference"],
                  "properties": {"reference": {"type": "string"}, "quantity": {"type": "null"}, "unit": {"enum": ["GRAM", "MILLILITER", "PIECE", null]}}
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reference", "quantity", "unit"],
                  "properties": {"reference": {"type": "string"}, "quantity": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["GRAM", "MILLILITER", "PIECE"]}}
                }
              ]
            }
          }
        }
      }
    }
  }
}
