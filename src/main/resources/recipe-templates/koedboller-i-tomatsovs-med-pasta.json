        }
      }
    },
    {
      "type": "TEXT",
      "instruction": {
        "parts": [
          {
            "text": "Form farsen til ca. "
          },
          {
            "scaledNumber": 6
          },
          {
            "text": " kødboller på størrelse med bordtennisbolde."
          }
        ]
      }
    },
    {
      "type": "PROCESS",
      "process": "PAN_FRY_MEATBALLS",
      "bindings": {
        "MEATBALLS": {
          "text": "Formede kødboller"
        },
        "FAT": {
          "ingredient": "RAPSOLIE",
          "quantity": 0.5,
          "unit": "TABLESPOON"
        }
      }
    },
    {
      "type": "TEXT",
      "instruction": "Tag kødbollerne af panden. De behøver ikke være gennemstegte endnu; de færdiggøres i tomatsovsen."
    },
    {
      "type": "PROCESS",
      "process": "BOIL_PASTA",
      "bindings": {
        "PASTA": {
          "ingredient": "PENNE",
          "quantity": 100,
          "unit": "GRAM"
        },
        "COOK_TIME": {
          "durationSeconds": 720
        }
      }
    },
    {
      "type": "TEXT",
      "instruction": {
        "parts": [
          {
            "text": "Skru panden ned til trin 4. Steg den resterende halvdel af det hakkede "
          },
          {
            "ingredient": "LOEG",
            "quantity": 0.25,
            "unit": "PIECE"
          },
          {
            "text": " i fedtet fra kødbollerne i 2 minutter, og rør cirka hvert 30. sekund."
          }
        ]
      }
    },
    {
      "type": "TEXT",
      "instruction": {
        "parts": [
          {
            "text": "Tilsæt "
          },
          {
            "ingredient": "HVIDLOEG",
            "quantity": 1,
            "unit": "PIECE"
          },
          {
            "text": " og steg i 30 sekunder. Tilsæt derefter "
          },
          {
            "ingredient": "TOMATPURE",
            "quantity": 0.5,
            "unit": "TABLESPOON"
          },
          {
            "text": " og steg videre i 1 minut, mens du rører."
          }
        ]
      }
    },
    {
      "type": "TEXT",
      "instruction": {
        "parts": [
          {
            "text": "Tilsæt "
          },
          {
            "ingredient": "HAKKEDE_TOMATER",
            "quantity": 200,
            "unit": "GRAM"
          },
          {
            "text": ", "
          },
          {
            "ingredient": "VAND_TIL_SOVS",
            "quantity": 0.5,
            "unit": "DECILITER"
          },
          {
            "text": ", "
          },
          {
            "ingredient": "TOERRET_TIMIAN",
            "quantity": 0.25,
            "unit": "TEASPOON"
          },
          {
            "text": ", "
          },
          {
            "ingredient": "SALT",
            "quantity": 0.25,
            "unit": "TEASPOON"
          },
          {
            "text": " og "
          },
          {
            "ingredient": "SORT_PEBER",
            "quantity": 2.5,
            "unit": "GRINDER_TURN"
          },
          {
            "text": ". Rør grundigt og skrab de brune stegerester fra bunden med op i sovsen. Skru op til trin 6, indtil sovsen bobler tydeligt."
          }
        ]
      }
    },
    {
      "type": "TEXT",
      "instruction": "Skru ned til trin 3. Læg kødbollerne tilbage i tomatsovsen, vend dem i sovsen og læg låg på. Lad dem småsimre i 10 minutter og vend dem efter 5 minutter."
    },
    {
      "type": "TEXT",
      "instruction": "Hvis kødbollerne er færdige før pastaen, sluk for panden og lad tomatsovsen stå med låg. Smag på en penne før vandet hældes fra; den skal være blød med lidt bid."
    },
    {
      "type": "TEXT",
      "instruction": "Server penne med kødboller og tomatsovs ovenpå. Pasta og sovs holdes adskilt frem til servering."
    }
  ]
