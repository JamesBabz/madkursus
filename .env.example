# Application database connection. Use the Compose service name "postgres", not localhost.
DB_URL=jdbc:postgresql://postgres:5432/madkursus_prod
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_a_strong_password

# PostgreSQL container initialization. These are only applied when its data volume is first created.
POSTGRES_DB=madkursus_prod
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_BIND_ADDRESS=replace_with_server_tailscale_ipv4
